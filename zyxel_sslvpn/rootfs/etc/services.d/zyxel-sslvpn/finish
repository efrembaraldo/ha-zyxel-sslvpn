#!/usr/bin/with-contenv bashio
# ==============================================================================
# Stop the add-on if the VPN client exits (fatal configuration/login errors)
# ==============================================================================
if [[ "${1}" -ne 0 ]] && [[ "${1}" -ne 256 ]]; then
  bashio::log.warning "VPN client exited with code ${1}"
fi
exec /run/s6/basedir/bin/halt
